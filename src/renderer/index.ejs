<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <!--
      Nothing is loaded from the internet: fonts are bundled (@fontsource) and the page may
      not connect anywhere itself - HTTP Client requests, OAuth and Docker go through the
      main process. Only the dev server's live reload (localhost) is allowed.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' data: blob:; frame-src 'self' blob: data:; object-src 'self' blob: data:; connect-src 'self' ws://localhost:* http://localhost:*; base-uri 'none'; form-action 'none'"
    />
    <title>Stackrun</title>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
